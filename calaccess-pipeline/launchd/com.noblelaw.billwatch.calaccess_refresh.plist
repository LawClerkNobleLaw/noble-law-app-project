<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.noblelaw.billwatch.calaccess_refresh</string>

    <!-- refresh.sh is executable with its own #!/bin/zsh shebang, so it's
         invoked directly — no /bin/zsh -c wrapper (see legiscan-lookup's
         plist for why: a -c command string splits on the spaces in
         "noble law app project", which is exactly what broke that job). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/daezhongilbarg/Projects/noble law app project/calaccess-pipeline/refresh.sh</string>
    </array>

    <!-- Runs once a day at 6:00am — before the 7:00am LegiScan watch-list
         job, so the two daily jobs don't both hit the network at once. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/daezhongilbarg/Projects/noble law app project/calaccess-pipeline/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daezhongilbarg/Projects/noble law app project/calaccess-pipeline/logs/launchd.err.log</string>
</dict>
</plist>
