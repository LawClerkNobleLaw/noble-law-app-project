<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.noblelaw.billwatch.refresh</string>

    <!-- zsh given the script PATH as a positional argument (not -c "text")
         reads it as a file directly — no shell re-parsing, so the spaces
         in "noble law app project" can't get word-split. Direct exec via
         the shebang alone (a single-element array) failed here with
         "can't open input file", so the interpreter is named explicitly. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/daezhongilbarg/Projects/noble law app project/legiscan-lookup/refresh.sh</string>
    </array>

    <!-- Runs 3x/day — 6am, 1pm, 8pm local time. StartCalendarInterval takes
         an array of dicts (each one an independent fire time) instead of a
         single dict when there's more than one; local system time zone, so
         no DST math needed here the way render.yaml's UTC cron entries do.
         digest.py only emails when a refresh actually finds a change (see
         its own comment), so running this 3x/day doesn't triple email
         volume for bills that haven't moved. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>13</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/daezhongilbarg/Projects/noble law app project/legiscan-lookup/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daezhongilbarg/Projects/noble law app project/legiscan-lookup/logs/launchd.err.log</string>
</dict>
</plist>
