<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.noblelaw.billwatch.refresh</string>

    <!-- zsh given the script PATH as a positional argument (not -c "text")
         reads it as a file directly — no shell re-parsing, so the spaces
         in "noble law app project" can't get word-split. Direct exec via
         the shebang alone (a single-element array) failed here with
         "can't open input file", so the interpreter is named explicitly. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/daezhongilbarg/Projects/noble law app project/legiscan-lookup/refresh.sh</string>
    </array>

    <!-- Runs once a day at 7:00am. Change Hour/Minute below to reschedule. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/daezhongilbarg/Projects/noble law app project/legiscan-lookup/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daezhongilbarg/Projects/noble law app project/legiscan-lookup/logs/launchd.err.log</string>
</dict>
</plist>
