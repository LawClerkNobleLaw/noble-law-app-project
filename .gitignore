# Local, per-machine runtime data — not part of the app's source.
legiscan-lookup/db/billwatch.db
# WAL mode's sidecar files (see db.get_connection()) — transient,
# SQLite manages them itself, never meant to be checked in.
legiscan-lookup/db/billwatch.db-wal
legiscan-lookup/db/billwatch.db-shm
# refresh_watchlist.py's and refresh_calaccess.py's own refresh_*.log
# (see their LOG_DIR) — lives under db.DB_DIR, same disk as the SQLite
# file above, which locally resolves to legiscan-lookup/db/logs for both.
legiscan-lookup/db/logs/*.log
# launchd's own stdout/stderr redirect (see legiscan-lookup/launchd/ and
# calaccess-pipeline/launchd/) — a separate log stream from the two
# refresh_*.log above, local-only (launchd doesn't run on Render), so
# this stays relative to each project's own checkout, not db.DB_DIR.
legiscan-lookup/logs/*.log
calaccess-pipeline/logs/*.log
__pycache__/
*.pyc
